    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Block_Closed_Won_Pending_Discounts</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(StageName),
    ISPICKVAL(StageName, &quot;Closed Won&quot;),
    Pending_Discount_Items__c &gt; 0
)</errorConditionFormula>
        <errorMessage>This opportunity has discount items pending approval. It can&apos;t be set to Closed Won until all pending discounts are resolved.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Record_Type_required</fullName>
        <active>true</active>
        <errorConditionFormula>Isblank( RecordType.Id )</errorConditionFormula>
        <errorMessage>Please select a record type!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_NeedsAnalysis_CloseDate</fullName>
        <active>true</active>
        <description>Validation Rule that enforces user to enter a Close Date n Opportunity Stage &quot;Needs Analysis&quot; before moving to the next stage.</description>
        <errorConditionFormula>AND(
ISCHANGED(StageName),
Stage_Order__c &gt;= 2,
CASE(PRIORVALUE(StageName),
&quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
&quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
ISBLANK( CloseDate )
)</errorConditionFormula>
        <errorMessage>Enter a Close Date, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_NeedsAnalysis_Competitors</fullName>
        <active>true</active>
        <description>Enforces a value in Competitors before moving to &quot;Proposal&quot; Opportunity stage</description>
        <errorConditionFormula>AND(
ISCHANGED(StageName),
Stage_Order__c &gt;= 2,
CASE(PRIORVALUE(StageName),
&quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
&quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
ISBLANK(  Competitors__c  )
)</errorConditionFormula>
        <errorMessage>Select a Competitor, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_NeedsAnalysis_ExpectedRevenue</fullName>
        <active>true</active>
        <description>Validation Rule that enforces user to enter an Amount in Opportunity Stage &quot;Needs Analysis&quot; before moving to the next stage.</description>
        <errorConditionFormula>AND(
ISCHANGED(StageName),
Stage_Order__c &gt; 2,
CASE(PRIORVALUE(StageName),
&quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
&quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
ISBLANK(Amount) || Amount = 0
)</errorConditionFormula>
        <errorMessage>Enter an Amount, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_Negotiation_DiscountApproval</fullName>
        <active>true</active>
        <description>Enforces Discount Approval Status to be &quot;Approved&quot;, before moving to &quot;Close Won&quot; Opportunity stage.</description>
        <errorConditionFormula>AND(
ISCHANGED(StageName),
Stage_Order__c &gt; 4,
CASE(PRIORVALUE(StageName),
&quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
&quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
NOT(ISPICKVAL( Discount_Approval_Status__c , &quot;Approved&quot;))
)</errorConditionFormula>
        <errorMessage>Discount Approval Status needs to be approved, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_Negotiation_LegalReview</fullName>
        <active>true</active>
        <description>Enforces LegalReview to be checked, before moving to &quot;Close Won&quot; Opportunity stage.</description>
        <errorConditionFormula>AND(
ISCHANGED(StageName),
Stage_Order__c &gt; 4,
CASE(PRIORVALUE(StageName),
&quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
&quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
NOT( Legal_Review__c )
)</errorConditionFormula>
        <errorMessage>Legal Review needs to be checked, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_Negotiation_OrderConfNumber</fullName>
        <active>true</active>
        <description>Enforces OrderConfirmationNumber to have a value, before moving to the next stage.</description>
        <errorConditionFormula>AND(
ISCHANGED(StageName),
Stage_Order__c &gt; 4,
CASE(PRIORVALUE(StageName),
&quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
&quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
ISBLANK( Order_Confirmation_Number__c )
)</errorConditionFormula>
        <errorMessage>OrderConfirmationNumber needs to have a value, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_Negotiation_WonLostReason</fullName>
        <active>true</active>
        <description>Enforces WonLostReason to have a value, before moving to the next stage (Closed Won) or to Closed Lost.</description>
        <errorConditionFormula>AND(
ISCHANGED(StageName),
OR(
AND(
Stage_Order__c &gt; 4,
CASE(PRIORVALUE(StageName),
&quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
&quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c
),
ISPICKVAL(StageName, &quot;Closed Lost&quot;)
),
ISBLANK(TEXT( Won_Lost_Reason__c ))
)</errorConditionFormula>
        <errorMessage>WonLostReason needs to have a value, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_Proposal_PriceBook</fullName>
        <active>true</active>
        <description>Enforces an active PriceBook before moving to &quot;Negotiation&quot; Opportunity stage.</description>
        <errorConditionFormula>AND(
ISCHANGED(StageName),
Stage_Order__c &gt; 3,
CASE(PRIORVALUE(StageName),
&quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
&quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
ISBLANK( Pricebook2.Id )

)</errorConditionFormula>
        <errorMessage>An active PriceBook needs to be attached to this Opportunity, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_Proposal_QuoteAttached</fullName>
        <active>true</active>
        <description>Enforces QuoteAttached to be checked, before moving to &quot;Negotiation&quot; Opportunity stage.</description>
        <errorConditionFormula>AND(
ISCHANGED(StageName),
Stage_Order__c &gt; 3,
CASE(PRIORVALUE(StageName),
&quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
&quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
NOT(  Quote_Attached__c  )
)</errorConditionFormula>
        <errorMessage>QuoteAttached needs to be checked, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_Qualification_BusinessUnit</fullName>
        <active>true</active>
        <description>Enforces a value in Business Unit before moving to &quot;Needs Analysis&quot; Opportunity stage</description>
        <errorConditionFormula>AND(
ISCHANGED(StageName),
Stage_Order__c &gt;= 1,
CASE(PRIORVALUE(StageName),
&quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
&quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
ISBLANK(TEXT( Business_Unit__c ))
)</errorConditionFormula>
        <errorMessage>Select a Business Unit, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_Qualification_LeadSource</fullName>
        <active>true</active>
        <description>Rule enforces a value for LeadSource in the Opportunity Qualification Stage</description>
        <errorConditionFormula>AND(
  ISCHANGED( StageName ),
  Stage_Order__c &gt;= 1,
  CASE(PRIORVALUE(StageName),
    &quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
    &quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
  ISBLANK(TEXT( LeadSource ))

)</errorConditionFormula>
        <errorMessage>Select a Lead Source, before moving to the next stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>VR_Opp_Qualification_PrimaryContact</fullName>
        <active>true</active>
        <description>Validation Rule enforces that a Primary Contact is selected for this Opportunity before it moves to the next Stage.</description>
        <errorConditionFormula>AND(
  ISCHANGED(StageName),
  Stage_Order__c &gt;= 1,
  CASE(PRIORVALUE(StageName),
    &quot;Qualification&quot;,1, &quot;Needs Analysis&quot;,2,
    &quot;Proposal&quot;,3, &quot;Negotiation&quot;,4, &quot;Closed Won&quot;,5, 0) &lt; Stage_Order__c,
  ISBLANK( Primary_Contact__c )
)</errorConditionFormula>
        <errorMessage>Select a Primary Contact, before moving to the next stage.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>DeliveryStatus</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>true</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>true</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Delivery Status</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>true</showsLocation>
        <showsStatus>true</showsStatus>
        <url>http://www.fedex.com/cgi-bin/tracking?tracknumbers={!Opportunity_Tracking_Number}&amp;action=track&amp;language=english&amp;cntry_code=us</url>
    </webLinks>
</CustomObject>
