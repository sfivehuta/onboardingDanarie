        <fullName>Lost_Reason_required</fullName>
        <active>true</active>
        <errorConditionFormula>AND (ISPICKVAL (Status, &apos;Lost&apos;), ISBLANK (TEXT(Lost_Reason__c)))</errorConditionFormula>
        <errorMessage>Lost Reason required when status is Lost</errorMessage>
    </validationRules>
